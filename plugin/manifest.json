{
  "manifestVersion": 5,
  "id": "com.amirsaeid.rhythmlab",
  "name": "RhythmLab",
  "version": "0.2.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "26.2.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "rhythmlabPanel",
      "label": { "default": "RhythmLab" },
      "minimumSize": { "width": 320, "height": 480 },
      "preferredDockedSize": { "width": 390, "height": 720 },
      "preferredFloatingSize": { "width": 440, "height": 760 }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "fullAccess"
  }
}
